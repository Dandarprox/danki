{
  "manifest_version": 3,
  "name": "Danki Clipper",
  "version": "1.0.0",
  "description": "Select words anywhere, save them as flashcards to Danki.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.workers.dev/*",
    "http://localhost:3000/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Danki"
  },
  "options_page": "options.html"
}

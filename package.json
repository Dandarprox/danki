{
  "name": "danki",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx concurrently -k \"bun run server:dev\" \"bun run client:dev\"",
    "server:dev": "bun --hot server/index.ts",
    "client:dev": "vite client --port 5173 --host",
    "build": "vite build client",
    "build:client": "vite build client",
    "start": "bun server/index.ts",
    "test": "bun test",
    "seeds:sql": "bun server/emit-seeds-sql.ts > seeds.sql",
    "cf:dev": "node_modules/.bin/wrangler dev",
    "cf:deploy": "bun run build && node_modules/.bin/wrangler deploy",
    "cf:migrate": "node_modules/.bin/wrangler d1 migrations apply danki --remote",
    "cf:seed": "node_modules/.bin/wrangler d1 execute danki --remote --file=seeds.sql",
    "cf:secret": "node_modules/.bin/wrangler secret put API_TOKEN"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "wrangler": "^4.128.0"
  }
}
